# Cle partagee attendue dans le header X-API-Key sur toutes les routes API sauf /. Sans cette
# valeur, l'authentification est desactivee (avec un avertissement au demarrage) — a definir
# obligatoirement en prod. Generer une valeur aleatoire, ex: openssl rand -hex 24.
API_KEY=

# Origine autorisee en CORS (dev local avec `ng serve` uniquement — en prod le frontend est servi
# depuis la meme origine et CORS n'entre pas en jeu). Vide = http://localhost:4200 par defaut.
CORS_ORIGIN=

# Database — en local (Docker) : voir les valeurs dans project_setup, DB_SSL absent/false.
# En cloud (Supabase) : utiliser le connection pooling (Supavisor) plutôt que la connexion directe
# (db.<projet>.supabase.co) — le tier gratuit Supabase n'expose la connexion directe qu'en IPv6, pas
# joignable depuis la plupart des hébergeurs (dont Render). Host du pooler du style
# aws-<region>.pooler.supabase.com, port 5432 (mode session, adapté à un backend qui garde ses
# connexions ouvertes comme celui-ci — le port 6543/mode transaction cible plutôt du serverless),
# DB_USER au format postgres.<ref-projet>. Toutes ces valeurs sont dans Project Settings → Database
# du tableau de bord Supabase.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=collect_play_db
DB_USER=roydev
DB_PASSWORD=
DB_SSL=false
# Chemin vers le certificat CA de Supabase pour verifier strictement le certificat du pooler
# Supavisor (auto-signe par defaut, d'ou l'echec sans ce fichier). A telecharger depuis Project
# Settings -> Database -> SSL Configuration du dashboard Supabase, ex: ./certs/supabase-ca.crt.
# Laisser vide desactive la verification stricte (rejectUnauthorized: false, trafic quand meme
# chiffre) avec un avertissement au demarrage.
DB_SSL_CA_PATH=

# Port d'écoute — laisser vide en local (retombe sur rdConfig.port, 6001). Les hébergeurs cloud
# (Render...) définissent PORT automatiquement, ne pas le fixer à la main dans ce cas.
PORT=

# IGDB API — Client ID/Secret d'une application Twitch Developer (dev.twitch.tv/console/apps),
# type de client "Confidentiel". Utilisé pour combler les régions manquantes du catalogue.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Supabase (prod) — utilisé uniquement par les scripts ponctuels (scripts/backup-supabase.ts,
# scripts/import-master-catalog.ts) qui se connectent directement à la prod, indépendamment de
# DB_HOST/DB_* ci-dessus (config du serveur, pointant en local sur Docker). Mêmes valeurs Supavisor
# que DB_HOST/DB_USER/DB_PASSWORD le seraient en prod (Project Settings → Database).
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
